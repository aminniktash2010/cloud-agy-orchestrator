# Service Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development

# Security & API Auth
ORCHESTRATOR_API_KEY=
ALLOWED_ORIGINS=*

# Google Cloud Settings
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_ARTIFACTS_BUCKET=

# Antigravity Agent Configuration
AGY_AGENT_ENABLED=true
AGY_READ_ONLY_MODE=false
AGY_DEFAULT_SYSTEM_PROMPT=You are an autonomous cloud agent orchestrator powered by Antigravity.
AGY_DEFAULT_MODEL=gemini-2.5-pro
AGY_TASK_TIMEOUT_SECONDS=600
